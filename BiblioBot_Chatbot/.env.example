APP_NAME="BiblioBot Chatbot"
ENVIRONMENT=development

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Backend .NET
DOTNET_API_BASE_URL=http://localhost:5218
DOTNET_API_TIMEOUT_SECONDS=10

# Modo de cliente .NET
# true  = usa MockDotNetClient para desarrollo/tests
# false = usa backend .NET real
USE_MOCK_DOTNET_CLIENT=true

# Seguridad interna
CHATBOT_INTERNAL_API_KEY=change_this_internal_key

# Mutaciones reales
# false = bloquea POST/PATCH/DELETE reales hacia backend
# true  = permite mutaciones reales solo en entorno de prueba controlado
ALLOW_REAL_BACKEND_MUTATIONS=false

# Token opcional para pruebas controladas de endpoints protegidos.
# No usar tokens reales aquí.
DOTNET_API_BEARER_TOKEN=