{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=bibliobot;Username=postgres;Password=1234"
  },
  "Jwt": {
    "Issuer": "BiblioBot",
    "Audience": "BiblioBot",
    "Secret": "BiblioBot_Development_Secret_Key_Change_This_For_Production_123456789",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Chatbot": {
    "BaseUrl": "http://localhost:8000",
    "MessagePath": "/chat/process",
    "TimeoutSeconds": 30
  },
  "ChatbotMutations": {
    "AllowRealCartMutations": false,
    "AllowRealSaleMutations": false,
    "AllowRealSaleConfirmationMutations": false,
    "AllowRealInventoryMutations": false,
    "AllowRealInvoiceMutations": false,
    "AllowRealRequestMutations": false
  }
}
